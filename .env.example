# AudienceLoop Environment Configuration

# Server Port
PORT=3000

# Microsoft Azure OpenAI Service (Optional - Deterministic Grounded Fallback used if omitted)
# AZURE_OPENAI_API_KEY="your-azure-openai-key"
# AZURE_OPENAI_ENDPOINT="https://your-resource-name.openai.azure.com"
# AZURE_OPENAI_DEPLOYMENT_NAME="gpt-4o"

# Google Gemini API Key (Optional - Automatically injected in Google AI Studio or configured locally)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Application URL
APP_URL="http://localhost:3000"
